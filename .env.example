# URL de l'application web Google Apps Script qui enregistre les commandes
# dans Google Sheets. Voir google-apps-script/README.md pour la générer.
GOOGLE_SHEETS_WEBHOOK_URL=

# Token d'accès de l'API de Conversions Meta, généré dans Events Manager
# (Paramètres > API Conversions > Générer un token) pour le pixel 1780866623109418.
META_CONVERSIONS_API_TOKEN=
